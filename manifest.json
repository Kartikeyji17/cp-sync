{
  "manifest_version": 3,

  "name": "CP Sync",

  "version": "1.0.0",

  "description": "Automatically sync LeetCode, Codeforces and CodeChef solutions to GitHub.",

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://www.codechef.com/*",
    "https://api.github.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "options_page": "options/options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [

    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "platforms/leetcodeParser.js",
        "content/cpSyncContent.js",
        "content/leetcode.js"
      ]
    },

    {
      "matches": [
        "https://codeforces.com/problemset/problem/*",
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/problemset/submission/*",
        "https://codeforces.com/contest/*/submission/*"
      ],
      "js": [
        "platforms/codeforcesParser.js",
        "content/cpSyncContent.js",
        "content/codeforces.js"
      ]
    },

    {
      "matches": [
        "https://www.codechef.com/problems/*",
        "https://www.codechef.com/submit/*",
        "https://www.codechef.com/viewsolution/*"
      ],
      "js": [
        "platforms/codechefParser.js",
        "content/cpSyncContent.js",
        "content/codechef.js"
      ]
    }

  ],

  "web_accessible_resources": [

    {

      "resources": [

        "inject/leetcodeInject.js"

      ],

      "matches": [

        "https://leetcode.com/*"

      ]

    }

  ]

}
